<?xml version="1.0" encoding="UTF-8"?>
<jdddPanel><DOOCSLayeredPane name="beam_overview" bounds="0,0,2880,960"><author>jzemella</author><description>Shift documentation: transmission, losses, orbit and corrector kicks along z</description><fillColor>210,210,210</fillColor><grid>5,5</grid><localParameters>beamline|FL1;tor|FLASH.DIAG/TOROID.ML;blm|FLASH.DIAG/BLM.HLC;single|LOSS.SINGLE.PERCENT;multi|LOSS.MULTI.PERCENT;integral|LOSS.INTEGRAL.PERCENT;orbit|FLASH.DIAG/ORBIT;mag|FLASH.MAGNETS/MAGNET.ML;zmin|0.0;zmax|320.0</localParameters>

<DOOCSLabel name="lb_title" bounds="10,5,600,30"><text>Beam overview ${beamline}</text><textColor>0,0,0</textColor><textFont>Arial,1,20</textFont><alignY>CENTER</alignY></DOOCSLabel>
<DOOCSLabel name="lb_ref" bounds="700,10,120,20"><text>Reference orbit:</text><textColor>0,0,0</textColor><textFont>Arial,0,12</textFont><alignX>RIGHT</alignX></DOOCSLabel>
<DOOCSValue name="v_ref" bounds="825,10,600,20"><adr>${orbit}//FLASH/ORBIT.REF.${beamline}.DESC</adr><maxLength>256</maxLength><textFont>Arial,0,12</textFont><textColor>0,0,153</textColor><enableValueDialog>false</enableValueDialog></DOOCSValue>
<DOOCSLabel name="lb_gold" bounds="1450,10,120,20"><text>Golden orbit:</text><textColor>0,0,0</textColor><textFont>Arial,0,12</textFont><alignX>RIGHT</alignX></DOOCSLabel>
<DOOCSValue name="v_gold" bounds="1575,10,600,20"><adr>${orbit}//FLASH/ORBIT.GOLD.${beamline}.DESC</adr><maxLength>256</maxLength><textFont>Arial,0,12</textFont><textColor>0,0,153</textColor><enableValueDialog>false</enableValueDialog></DOOCSValue>

<DOOCSPlotLocation name="transmission" bounds="0,40,2880,130">
<updateTime>1.0</updateTime><titleText>Transmission (charge)</titleText><titleFont>Arial,0,14</titleFont><bgColor>210,210,210</bgColor><showLegend>false</showLegend><locationInM>true</locationInM><masterXScale>flashBeamOverview</masterXScale>
<adr0>${tor}/*/CHARGE.${beamline}</adr0><lineColor0>0,102,204</lineColor0><lineStyle0>Bar</lineStyle0><lineWidth0>5</lineWidth0>
<xMin>${zmin}</xMin><xMax>${zmax}</xMax><xScaleFromServer>false</xScaleFromServer><xAutoScale>false</xAutoScale><xTextFont>Arial,0,12</xTextFont><yMin>0.0</yMin><yAutoScale>true</yAutoScale><yTextFont>Arial,0,12</yTextFont></DOOCSPlotLocation>

<DOOCSPlotLocation name="losses" bounds="0,170,2880,230">
<updateTime>1.0</updateTime><titleText>BLM losses (% of threshold): integral / multi / single</titleText><titleFont>Arial,0,14</titleFont><bgColor>210,210,210</bgColor><showLegend>false</showLegend><locationInM>true</locationInM><masterXScale>flashBeamOverview</masterXScale>
<adr0>${blm}/*/${integral}</adr0><lineColor0>200,200,255</lineColor0><lineStyle0>Bar</lineStyle0><lineWidth0>9</lineWidth0>
<adr1>${blm}/*/${multi}</adr1><lineColor1>255,153,0</lineColor1><lineStyle1>Bar</lineStyle1><lineWidth1>6</lineWidth1>
<adr2>${blm}/*/${single}</adr2><lineColor2>204,0,0</lineColor2><lineStyle2>Bar</lineStyle2><lineWidth2>3</lineWidth2>
<xMin>${zmin}</xMin><xMax>${zmax}</xMax><xScaleFromServer>false</xScaleFromServer><xAutoScale>false</xAutoScale><xTextFont>Arial,0,12</xTextFont><yMin>0.0</yMin><yMax>120.0</yMax><yAutoScale>false</yAutoScale><yTextFont>Arial,0,12</yTextFont></DOOCSPlotLocation>

<DOOCSPlotLocation name="orbitH" bounds="0,400,2880,170">
<updateTime>1.0</updateTime><titleText>Orbit horizontal: absolute / difference to reference</titleText><titleFont>Arial,0,14</titleFont><bgColor>210,210,210</bgColor><showLegend>false</showLegend><locationInM>true</locationInM><masterXScale>flashBeamOverview</masterXScale>
<adr0>${orbit}/*/X.${beamline}</adr0><lineColor0>140,170,215</lineColor0><lineStyle0>Bar</lineStyle0><lineMark0>Circle</lineMark0>
<adr1>${orbit}/*/X.${beamline}.DIFF</adr1><lineColor1>204,0,0</lineColor1><lineStyle1>VarBar</lineStyle1>
<xMin>${zmin}</xMin><xMax>${zmax}</xMax><xScaleFromServer>false</xScaleFromServer><xAutoScale>false</xAutoScale><xTextFont>Arial,0,12</xTextFont><yMin>-1.0</yMin><yMax>1.0</yMax><yAutoScale>false</yAutoScale><yTextFont>Arial,0,12</yTextFont></DOOCSPlotLocation>

<DOOCSPlotLocation name="orbitV" bounds="0,570,2880,170">
<updateTime>1.0</updateTime><titleText>Orbit vertical: absolute / difference to reference</titleText><titleFont>Arial,0,14</titleFont><bgColor>210,210,210</bgColor><showLegend>false</showLegend><locationInM>true</locationInM><masterXScale>flashBeamOverview</masterXScale>
<adr0>${orbit}/*/Y.${beamline}</adr0><lineColor0>140,170,215</lineColor0><lineStyle0>Bar</lineStyle0><lineMark0>Circle</lineMark0>
<adr1>${orbit}/*/Y.${beamline}.DIFF</adr1><lineColor1>204,0,0</lineColor1><lineStyle1>VarBar</lineStyle1>
<xMin>${zmin}</xMin><xMax>${zmax}</xMax><xScaleFromServer>false</xScaleFromServer><xAutoScale>false</xAutoScale><xTextFont>Arial,0,12</xTextFont><yMin>-1.0</yMin><yMax>1.0</yMax><yAutoScale>false</yAutoScale><yTextFont>Arial,0,12</yTextFont></DOOCSPlotLocation>

<DOOCSPlotLocation name="kickH" bounds="0,740,2880,110">
<updateTime>1.0</updateTime><titleText>Corrector SP horizontal</titleText><titleFont>Arial,0,14</titleFont><bgColor>210,210,210</bgColor><showLegend>false</showLegend><locationInM>true</locationInM><masterXScale>flashBeamOverview</masterXScale>
<adr0>${mag}/H*/KICK_MRAD.SP</adr0><lineColor0>0,153,255</lineColor0><lineStyle0>Bar</lineStyle0>
<xMin>${zmin}</xMin><xMax>${zmax}</xMax><xScaleFromServer>false</xScaleFromServer><xAutoScale>false</xAutoScale><xTextFont>Arial,0,12</xTextFont><yMin>-1.0</yMin><yMax>1.0</yMax><yAutoScale>false</yAutoScale><yTextFont>Arial,0,12</yTextFont></DOOCSPlotLocation>

<DOOCSPlotLocation name="kickV" bounds="0,850,2880,110">
<updateTime>1.0</updateTime><titleText>Corrector SP vertical</titleText><titleFont>Arial,0,14</titleFont><bgColor>210,210,210</bgColor><showLegend>false</showLegend><locationInM>true</locationInM><masterXScale>flashBeamOverview</masterXScale>
<adr0>${mag}/V*/KICK_MRAD.SP</adr0><lineColor0>0,153,255</lineColor0><lineStyle0>Bar</lineStyle0>
<xMin>${zmin}</xMin><xMax>${zmax}</xMax><xScaleFromServer>false</xScaleFromServer><xAutoScale>false</xAutoScale><xTextFont>Arial,0,12</xTextFont><yMin>-1.0</yMin><yMax>1.0</yMax><yAutoScale>false</yAutoScale><yTextFont>Arial,0,12</yTextFont></DOOCSPlotLocation>
</DOOCSLayeredPane>
</jdddPanel>
